# --- Required -------------------------------------------------------------

# Bot token from @BotFather.
BOT_TOKEN=123456:ABC-your-token-here

# --- Optional -------------------------------------------------------------

# Comma-separated chat ids of the discussion group(s) the bot should act in.
# Leave empty to act in every group where the bot is an admin.
# Tip: forward a message from the group to @userinfobot, or check the bot logs.
DISCUSSION_GROUP_IDS=

# How aliases look:
#   name   -> "Brave Otter"      (default; readable, conversation stays followable)
#   number -> "Anonymous #0042"
#   fixed  -> "Anonymous"        (every commenter looks identical)
ALIAS_STYLE=name

# Secret salt used to derive pseudonyms. Keep it private and stable.
# If unset, a value is derived from BOT_TOKEN automatically.
ALIAS_SALT=

# Anonymize group admins/mods too? Default keeps their identity visible.
ANONYMIZE_ADMINS=false

# Emoji shown before each alias.
LABEL_EMOJI=🕵️

# Seconds to cache each group's admin list.
ADMIN_CACHE_TTL=300

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
